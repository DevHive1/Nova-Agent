{
  "name": "agent-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:ts": "ts-node server/index.ts",
    "start": "concurrently \"node server/index.js\" \"vite\"",
    "start:ts": "concurrently \"ts-node server/index.ts\" \"vite\"",
    "telegram": "node telegram/bot.js",
    "telegram:ts": "ts-node telegram/bot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ts": "vitest run tests/*.test.ts",
    "build:ts": "tsc",
    "compile": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.13",
    "compression": "^1.8.1",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "node-fetch": "^3.3.2",
    "node-telegram-bot-api": "^0.66.0",
    "perf_hooks": "^0.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "redis": "^6.2.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/node": "^26.4.1",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  }
}
